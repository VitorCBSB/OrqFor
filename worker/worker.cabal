cabal-version: 3.0
name:          Worker
version:       0.1.0.0
author:        Vitor Coimbra
build-type:    Simple

executable worker
    main-is: Main.hs
    hs-source-dirs: app, src
    other-modules:
        Ambiente
        ConfigWorker
        Execucao
        Pendentes
        Sessao
        SessaoGrafica
    default-language: GHC2024
    build-depends: base >= 4 && < 5, aeson, shared, websockets, bytestring, text, stm, process, directory, filepath
    ghc-options: -Wall -threaded
    -- APIs do Windows usadas pela verificação da sessão gráfica (módulo SessaoGrafica)
    if os(windows)
        extra-libraries: wtsapi32 user32
